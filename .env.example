# Copy to .env if you like; RepoDoctor reads the PROCESS ENVIRONMENT (set these in your shell). NEVER commit secrets.
AWS_REGION=us-east-1

# Amazon Bedrock: an inference profile id your account can call (see: python scripts/check_bedrock.py).
# Auth comes from AWS_BEARER_TOKEN_BEDROCK (Bedrock API key) or normal AWS credentials. Do not put keys in files.
BEDROCK_MODEL_ID=
REPODOCTOR_MODEL_MAX_TOKENS=2048
REPODOCTOR_MAX_SESSION_TOKENS=200000
# Optional, only to display a cost estimate: USD per 1M tokens for YOUR model (check the pricing page)
REPODOCTOR_PRICE_INPUT_PER_MTOK=
REPODOCTOR_PRICE_OUTPUT_PER_MTOK=
# Set to 1 to allow the opt-in tests that call real Bedrock (they cost a little money)
REPODOCTOR_RUN_AWS_TESTS=

# Agent safety limits
REPODOCTOR_MAX_ITERATIONS=3
REPODOCTOR_MAX_TOOL_CALLS=25

# Sandbox limits
REPODOCTOR_SANDBOX_IMAGE=repodoctor-sandbox:0.1
REPODOCTOR_SANDBOX_MEMORY=512m
REPODOCTOR_SANDBOX_CPUS=1
REPODOCTOR_TEST_TIMEOUT_SECONDS=60
REPODOCTOR_MAX_TIMEOUT_SECONDS=300
REPODOCTOR_MAX_OUTPUT_BYTES=1000000

# API server (python -m repodoctor.api)
REPODOCTOR_DATA_DIR=data
REPODOCTOR_HOST=127.0.0.1
REPODOCTOR_PORT=8000
# bedrock = real model; demo = scripted patch for the sample repository only (labelled simulated)
REPODOCTOR_ENGINE=bedrock
REPODOCTOR_MAX_ACTIVE_SESSIONS=2
REPODOCTOR_MAX_UPLOAD_BYTES=20000000
REPODOCTOR_MAX_UNPACKED_BYTES=100000000
REPODOCTOR_WAITING_TTL_SECONDS=1800
REPODOCTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
